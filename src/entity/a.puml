@startuml
title Modèle des entités

left to right direction
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 45
skinparam ranksep 55
hide empty members

package "Entités" {
  abstract class Entity {
    #id : int
    #type : EntityType
    #position : Point
    #movementState : MovementState
    #combatStats : CombatStats
    #interactionData : InteractionData
    #collisionData : CollisionData
    #animationSet : AnimationSet
    +translate(dX : int, dY : int) : void
    +hasMovementState() : boolean
    +getPosition() : Point
    +getMovementState() : MovementState
    +getCollisionData() : CollisionData
  }
  class Player
  class Enemy
  class Npc <<placeholder>>
  abstract class WorldObject <<placeholder>>
  enum EntityType
}

package "État et données" {
  class MovementState {
    +direction : Direction
    +desiredMovementX : double
    +desiredMovementY : double
    +movementDelta : Point
    +speed : double
    +fractionalX : double
    +fractionalY : double
  }
  class CollisionData {
    +area : Rectangle
    +solidArea : Rectangle
  }
  class CombatStats {
    +damage : int
  }
  class InteractionData
  enum Direction
}

package "Gestion" {
  class EntityManager {
    -entityMap : Map<Integer, Entity>
    -nextId : int
    +generateId() : int
    +addEntity(entity : Entity) : void
    +removeEntity(id : int) : void
    +getEntity(id : int) : Entity
    +getEntities() : Collection<Entity>
  }
  class EntityFactory {
    -entityManager : EntityManager
    +createPlayer(x : int, y : int) : Player
    +createEnemy(x : int, y : int) : Enemy
  }
}

Player --|> Entity
Enemy --|> Entity
Entity --> EntityType
Entity *-- "0..1" MovementState
Entity *-- "0..1" CollisionData
Entity *-- "0..1" CombatStats
Entity *-- "0..1" InteractionData
MovementState --> Direction : orientation du sprite

EntityManager o-- "0..*" Entity
EntityFactory --> EntityManager : attribue les identifiants
EntityFactory ..> Player : crée
EntityFactory ..> Enemy : crée

note bottom of Npc
  Npc et WorldObject sont des placeholders.
  Ils ne sont pas encore intégrés à Entity.
end note

note bottom of MovementState
  L'intention de déplacement est un vecteur continu.
  direction conserve l'orientation parmi les 8 sprites.
end note

@enduml
