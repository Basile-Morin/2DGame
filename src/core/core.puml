+ void removeRenderer(Renderer renderer)
+ void render(Graphics2D g2)
}

class core.SystemManager{
- ArrayList<ISystem> systems
+ ArrayList<ISystem> getSystems()
+ void addSystem(ISystem system)
+ void removeSystem(ISystem system)
+ void update()
}

class core.GameConfig  <<constantes>> {
+ {static} int originalTileSize
+ {static} int scale
+ {static} int tileSize
