@startuml
title Démarrage, boucle et orchestration

left to right direction
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 55

package "Démarrage et Swing" {
  class Main {
    {static} +main(args : String[]) : void
  }
  class GameLoop {
    -gameThread : Thread
    -panel : GamePanel
    -game : Game
    -running : boolean
    +startGameThread() : void
    +run() : void
  }
  class GamePanel {
    -game : Game
    +paintComponent(g : Graphics) : void
  }
}

package "Orchestration" {
  class Game {
    -gameStateLock : Object
    -rendererManager : RendererManager
    -systemManager : SystemManager
    -inputState : InputState
    +update(deltaSeconds : double) : void
    +render(g2 : Graphics2D) : void
    +initialize() : void
  }
  class SystemManager {
    -systems : ArrayList<ISystem>
    +addSystem(system : ISystem) : void
    +update(deltaSeconds : double) : void
  }
  class RendererManager {
    -renderers : ArrayList<IRenderer>
    +addRenderer(renderer : IRenderer) : void
    +render(g2 : Graphics2D) : void
  }
}

package "Entrées" {
  class InputListener {
    -inputState : InputState
    +keyTyped(e : KeyEvent) : void
    +keyPressed(e : KeyEvent) : void
    +keyReleased(e : KeyEvent) : void
    +getInputState() : InputState
  }
  class InputState <<thread-safe>> {
    -inputs : boolean[]
    -lock : Object
    +getInputs() : boolean[]
    +getInput(code : int) : boolean
    +setInput(input : boolean, code : int) : void
  }
}

package "Contrats" {
  interface ISystem {
    +update(deltaSeconds : double) : void
  }
  interface IRenderer {
    +draw(g : Graphics2D) : void
  }
}

package "Systèmes enregistrés par Game" {
  class PlayerInputSystem
  class MovementSystem
  class AnimationSystem
}

class GameConfig <<constantes>> {
  {static} +FPS : int
  {static} +UPDATE_INTERVAL_NS : long
  {static} +FIXED_DELTA_SECONDS : double
  {static} +ENTITY_BASE_SPEED_PX_PER_SECOND : double
  {static} +TILESIZE : int
  {static} +SCREENWIDTH : int
  {static} +SCREENHEIGHT : int
}

Main ..> Game : crée
Main ..> InputListener : crée
Main ..> GamePanel : crée
Main ..> GameLoop : démarre
GameLoop --> Game : update(dt)
GameLoop --> GamePanel : repaint()
GamePanel --> Game : render(g2)

Game o-- SystemManager
Game o-- RendererManager
Game --> InputState : transmet aux systèmes
InputListener --> InputState : met à jour
SystemManager o-- ISystem : exécute
RendererManager o-- IRenderer : appelle

ISystem <|.. PlayerInputSystem
ISystem <|.. MovementSystem
ISystem <|.. AnimationSystem

GameLoop ..> GameConfig : cadence fixe
Game ..> GameConfig : configuration

note bottom of SystemManager
  Ordre d'enregistrement actuel :
  PlayerInputSystem -> MovementSystem -> AnimationSystem
end note

@enduml
