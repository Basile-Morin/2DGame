+ {static} int maxScreenLine
+ {static} int screenWidth
+ {static} int screenHeight
+ {static} int FPS
+ {static} double drawInterval
+ {static} int worldColNumber
+ {static} int worldLineNumber
+ {static} int ENTITYBASESPEED
}

class core.GamePanel {
- Game game
+ void paintComponent(Graphics)
}


class core.Main {
+ {static} void main(String[])
}

class core.GameLoop {
- Thread gameThread
- GamePanel panel
- Game game
+ void startGameThread()
+ void run()
}

class core.input.InputListener {
- InputState inputState
+ void keyTyped(KeyEvent)
+ void keyPressed(KeyEvent)
+ void keyReleased(KeyEvent)
+ InputState getInputState()
}

class core.input.InputState <<data>> {
- boolean[] inputs
+ boolean[] getInputs()
+ void setInput(boolean,int)
}

Game <-- Main : Créer
GamePanel <-- Main : Créer
GameLoop <-- Main : Créer et lance
Game <-- GameLoop : Update
GamePanel <-- GameLoop : Repaint
Game <-- GamePanel : Appelle render()
core.RendererManager <-- Game : créer et appelle render()
core.SystemManager <-- Game : créer et appelle update()
core.input.InputListener <-- Main : Initialise
core.input.InputState <-- core.input.InputListener : Met à jour
InputState <-- Game : Lit les coordonnées





@enduml