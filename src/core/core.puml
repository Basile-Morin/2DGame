@startuml

class core.Game {
- InputState inputState
- RendererManager rendererManager
- SystemManager systemManager
+ void update()
+ void render(Graphics2D)
+ void initialize()
}

class core.RendererManager{
- ArrayList<Renderer> renderers
+ ArrayList<Renderer> getRenderers()
