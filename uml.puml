@startuml
title Architecture générale de Jeu2

left to right direction
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
skinparam componentStyle rectangle
skinparam nodesep 45
skinparam ranksep 60

package "Présentation" as presentation {
  component "Main / Swing" as ui
  component "GameLoop" as loop
}

package "Orchestration" as orchestration {
  component "Game" as game
  component "SystemManager" as systems
  component "RendererManager" as renderers
}

package "Entrées" as input {
  component "InputListener" as listener
  component "InputState" as inputState
  component "PlayerInputSystem" as playerInput
}

package "Simulation" as simulation {
  component "MovementSystem" as movement
  component "AnimationSystem" as animation
  component "EntityCollisionCalculator" as collision
}

package "Modèle" as model {
  component "Entity / EntityManager" as entities
  component "MovementState" as movementState
}

package "Carte et affichage" as world {
  component "TileMap" as tileMap
  component "MapRenderer" as mapRenderer
  component "EntityAnimationRenderer" as entityRenderer
}

ui --> loop
loop --> game : update(dt)
loop --> ui : repaint()
game --> systems : update(dt)
game --> renderers : render()
listener --> inputState : clavier
inputState --> playerInput : état des touches
systems --> playerInput
systems --> movement
systems --> animation
playerInput --> movementState : intention
movement --> movementState : résultat du déplacement
movement --> collision : collisions
collision --> tileMap
animation --> movementState : orientation et déplacement réel
renderers --> mapRenderer
renderers --> entityRenderer
mapRenderer --> tileMap
entityRenderer --> entities

note bottom of systems
  Ordre d'exécution :
  entrée du joueur -> mouvement -> animation
end note

@enduml
